# =============================================================================
# hubspot-deals-etl - environment template
# Copy to .env and adjust. NEVER commit .env or a real HubSpot token.
# docker-compose.yml already sets dev values; .env overrides the ${VAR:-default}
# entries in it and is used when running the app outside Docker.
# =============================================================================

# ---- Flask ----
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
PORT=5200
HOST=0.0.0.0
APP_TITLE=HubSpot Deals ETL
APP_VERSION=1.0.0

# ---- Credential encryption (access tokens are stored encrypted per job) ----
ENCRYPTION_ENABLED=true
CONFIG_PASSWORD=dev-config-password-change-me

# ---- Inbound API auth (optional) ----
# When set, /api/* (except /api/health and the docs) requires header X-API-Key.
SERVICE_API_KEY=

# ---- Database (development) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_deals_data_dev
DB_USER=postgres
DB_PASSWORD=password123
DB_SCHEMA=hubspot_deals_dev

# ---- DLT ----
DLT_PIPELINE_NAME=hubspot_deals_pipeline_dev
DLT_WORKING_DIR=.dlt
DESTINATION__POSTGRES__CREDENTIALS__DATABASE=hubspot_deals_data_dev
DESTINATION__POSTGRES__CREDENTIALS__USERNAME=postgres
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=password123
DESTINATION__POSTGRES__CREDENTIALS__HOST=localhost
DESTINATION__POSTGRES__CREDENTIALS__PORT=5432

# ---- HubSpot CRM API ----
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
# Client-side limiter. HubSpot private-app burst limits: Free/Starter 100/10s,
# Pro/Enterprise 190/10s. The test spec uses 150/10s. 429s are retried anyway.
HUBSPOT_RATE_LIMIT_REQUESTS=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10
HUBSPOT_MAX_RETRIES=3
HUBSPOT_RETRY_BACKOFF_SECONDS=1
# Page size for GET /crm/v3/objects/deals (max 100)
HUBSPOT_PAGE_SIZE=100
# Save a checkpoint every N pages
HUBSPOT_CHECKPOINT_INTERVAL=10
HUBSPOT_MAX_PAGES=10000
# Testing only: sleep before each HubSpot request (makes pause/resume testable)
HUBSPOT_TEST_DELAY_SECONDS=0

# Only used by scripts/ (seed + verification). The service itself receives the
# token in each scan request body.
HUBSPOT_ACCESS_TOKEN=pat-na1-your-token-here

# ---- Service ----
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7

# ---- Logging ----
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
